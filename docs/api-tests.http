@baseUrl = http://localhost:8081
@json = application/json

# Run the API on port 8081 before starting this collection.
# IDs are taken from create responses; DELETE requests below target only this run's fixtures.

### Psicólogos - criar
# @name criaPsicologo
POST {{baseUrl}}/psicologos
Content-Type: {{json}}

{
  "nome": "ApiTest{{$timestamp}}",
  "cpf": "9{{$timestamp}}01",
  "email": "api-psicologo-{{$guid}}@example.invalid",
  "telefone": "1199{{$timestamp}}",
  "senha": "ApiTest123!",
  "crp": "API{{$timestamp}}",
  "especialidade": "ApiTestTCC",
  "ativo": true
}

### Psicólogos - listar
GET {{baseUrl}}/psicologos

### Psicólogos - listar ativos
GET {{baseUrl}}/psicologos/ativos

### Psicólogos - buscar por id
GET {{baseUrl}}/psicologos/{{criaPsicologo.response.body.$.id}}

### Psicólogos - buscar por CRP
GET {{baseUrl}}/psicologos/por-crp?crp={{criaPsicologo.response.body.$.crp}}

### Psicólogos - buscar por especialidade
GET {{baseUrl}}/psicologos/por-especialidade?especialidade=ApiTestTCC

### Psicólogos - atualizar
PUT {{baseUrl}}/psicologos/{{criaPsicologo.response.body.$.id}}
Content-Type: {{json}}

{
  "nome": "ApiTestAtualizado",
  "cpf": "{{criaPsicologo.response.body.$.cpf}}",
  "email": "{{criaPsicologo.response.body.$.email}}",
  "telefone": "{{criaPsicologo.response.body.$.telefone}}",
  "senha": "ApiTest123!",
  "crp": "{{criaPsicologo.response.body.$.crp}}",
  "especialidade": "ApiTestTCC",
  "ativo": true
}

### Psicólogos - inativar
PATCH {{baseUrl}}/psicologos/{{criaPsicologo.response.body.$.id}}/inativar

