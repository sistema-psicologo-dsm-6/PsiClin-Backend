@baseUrl = http://localhost:8081
@json = application/json
@adminEmail = admin@psiclin.local
@adminSenha = Admin123!

# Run the API on port 8081 before starting this collection.
# Pre-requisito: existir um funcionario ADMIN (veja o README, "Criando o primeiro ADMIN").
# Todas as rotas (exceto /auth/signin) exigem "Authorization: Bearer {{token}}".

### Auth - signin (ADMIN)
# @name login
POST {{baseUrl}}/auth/signin
Content-Type: {{json}}

{
  "email": "{{adminEmail}}",
  "senha": "{{adminSenha}}"
}

###
@token = {{login.response.body.$.token}}

### Auth - signup (cria funcionario; exige ADMIN)
POST {{baseUrl}}/auth/signup
Content-Type: {{json}}
Authorization: Bearer {{token}}

{
  "nome": "ApiTestSignup",
  "cpf": "9{{$timestamp}}09",
  "email": "api-signup-{{$guid}}@example.invalid",
  "telefone": "1199{{$timestamp}}",
  "senha": "ApiTest123!",
  "role": "RECEPCIONISTA",
  "ativo": true
}

### Auth - signin com senha errada (esperado 401)
POST {{baseUrl}}/auth/signin
Content-Type: {{json}}

{
  "email": "{{adminEmail}}",
  "senha": "senha-errada"
}

### Seguranca - sem token (esperado 401)
GET {{baseUrl}}/pacientes

### Seguranca - token invalido (esperado 401)
GET {{baseUrl}}/pacientes
Authorization: Bearer token.invalido.aqui

### Seguranca - funcionario RECEPCIONISTA
# @name criaRecepFunc
POST {{baseUrl}}/funcionarios
Content-Type: {{json}}
Authorization: Bearer {{token}}

{
  "nome": "ApiTestRecepFunc",
  "cpf": "9{{$timestamp}}08",
  "email": "api-recep-func-{{$guid}}@example.invalid",
  "telefone": "1199{{$timestamp}}",
  "senha": "ApiTest123!",
  "role": "RECEPCIONISTA",
  "ativo": true
}

### Seguranca - signin como RECEPCIONISTA
# @name loginRecep
POST {{baseUrl}}/auth/signin
Content-Type: {{json}}

{
  "email": "{{criaRecepFunc.response.body.$.email}}",
  "senha": "ApiTest123!"
}

### Seguranca - RECEPCIONISTA lista pacientes (esperado 200)
GET {{baseUrl}}/pacientes
Authorization: Bearer {{loginRecep.response.body.$.token}}

### Seguranca - RECEPCIONISTA acessa prontuarios (esperado 403)
GET {{baseUrl}}/prontuarios
Authorization: Bearer {{loginRecep.response.body.$.token}}

### Seguranca - RECEPCIONISTA acessa funcionarios (esperado 403)
GET {{baseUrl}}/funcionarios
Authorization: Bearer {{loginRecep.response.body.$.token}}

### Psicólogos - criar
# @name criaPsicologo
POST {{baseUrl}}/psicologos
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "nome": "ApiTest{{$timestamp}}",
  "cpf": "9{{$timestamp}}01",
  "email": "api-psicologo-{{$guid}}@example.invalid",
  "telefone": "1199{{$timestamp}}",
  "senha": "ApiTest123!",
  "crp": "API{{$timestamp}}",
  "especialidade": "ApiTestTCC",
  "ativo": true
}

### Psicólogos - listar
GET {{baseUrl}}/psicologos
Authorization: Bearer {{token}}

### Psicólogos - listar ativos
GET {{baseUrl}}/psicologos/ativos
Authorization: Bearer {{token}}

### Psicólogos - buscar por id
GET {{baseUrl}}/psicologos/{{criaPsicologo.response.body.$.id}}
Authorization: Bearer {{token}}

### Psicólogos - buscar por CRP
GET {{baseUrl}}/psicologos/por-crp?crp={{criaPsicologo.response.body.$.crp}}
Authorization: Bearer {{token}}

### Psicólogos - buscar por especialidade
GET {{baseUrl}}/psicologos/por-especialidade?especialidade=ApiTestTCC
Authorization: Bearer {{token}}

### Psicólogos - atualizar
PUT {{baseUrl}}/psicologos/{{criaPsicologo.response.body.$.id}}
Authorization: Bearer {{token}}
Content-Type: {{json}}

{
  "nome": "ApiTestAtualizado",
  "cpf": "{{criaPsicologo.response.body.$.cpf}}",
  "email": "{{criaPsicologo.response.body.$.email}}",
  "telefone": "{{criaPsicologo.response.body.$.telefone}}",
  "senha": "ApiTest123!",
  "crp": "{{criaPsicologo.response.body.$.crp}}",
  "especialidade": "ApiTestTCC",
  "ativo": true
}

### Psicólogos - inativar
PATCH {{baseUrl}}/psicologos/{{criaPsicologo.response.body.$.id}}/inativar
Authorization: Bearer {{token}}

